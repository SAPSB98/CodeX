{
  "name": "codex",
  "version": "1.0.0",
  "description": "SAP Code Generator for CAP, RAP and BTP",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev:renderer": "vite",
    "dev:electron": "set NODE_ENV=development && electron .",
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:electron\"",
    "build:renderer": "vite build",
    "build": "npm run build:renderer && electron-builder"
  },
  "build": {
    "appId": "com.accenture.codex",
    "productName": "CodeX",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "dist/**/*",
      "main.js",
      "preload.js",
      "src/prompts/**/*"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^4.0.0",
    "electron-store": "^8.1.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^8.0.0",
    "electron": "^30.0.0",
    "electron-builder": "^24.0.0",
    "vite": "^5.0.0"
  }
}